# Copy to .env and fill in. .env is git-ignored: NEVER commit it.

# ---- Blockchain (required) -------------------------------------------------
# Private key of the Innoblock Burner wallet (the one that deployed the contract,
# so it is already an authorized publisher). MetaMask -> account menu -> Account details.
PRIVATE_KEY=0xyour_burner_private_key
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x119cC959d84C882893468134eC0F5b78f571EF5B
EXPLORER_URL=https://sepolia.etherscan.io

# ---- Database ----------------------------------------------------------------
# Empty = local SQLite file. On Render paste a Neon/Supabase Postgres string.
DATABASE_URL=

# ---- Web -----------------------------------------------------------------------
FRONTEND_ORIGIN=*
# Any long random string. Needed for /backfill and to skip the run cooldown.
ADMIN_TOKEN=change_me_to_a_long_random_string
RUN_COOLDOWN_SECONDS=120

# ---- AI (optional: empty API_KEY = keyword fallback scorer) ------------------
# Any OpenAI-compatible API. Free options:
#   Groq    https://api.groq.com/openai/v1
#   Gemini  https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL = a current model name from your provider's model list.
API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=

# ---- Agent -------------------------------------------------------------------
TOKENS=BTC,ETH,SOL,XRP,DOGE
NEWS_WINDOW_HOURS=24
MAX_HEADLINES_PER_TOKEN=15
